---
// NumberField.astro - Technical instrument input
import { formatInputLimits } from '../lib/inputLimits';
interface Props {
  id: string;
  label: string;
  unit?: string;
  value: number | string;
  min?: number;
  max?: number;
  step?: number;
  required?: boolean;
  error?: string;
  warning?: string;
  placeholder?: string;
  help?: string;
}
const { id, label, unit, value, min, max, step, required = true, error, warning, placeholder, help } = Astro.props;
const fieldId = `${id}-field`;
const errorId = error ? `${id}-error` : undefined;
const warningId = warning ? `${id}-warning` : undefined;
const limitsId = `${id}-limits`;
const helpId = help ? `${id}-help` : undefined;
const describedBy = [limitsId, helpId, errorId, warningId].filter(Boolean).join(' ');
---

<div class="field">
  <label for={fieldId} class="field-label">
    {label}
    {unit && <span class="field-unit">{unit}</span>}
    {required && <span class="req" aria-hidden="true">*</span>}
  </label>
  <input
    type="number"
    id={fieldId}
    name={id}
    data-label={label}
    data-unit={unit}
    value={value}
    min={min}
    max={max}
    step={step}
    required={required}
    class="field-input"
    aria-invalid={error ? 'true' : 'false'}
    aria-describedby={describedBy}
    placeholder={placeholder}
  />
  <p id={limitsId} class="field-limits">{formatInputLimits({ min, max, step, unit })}</p>
  {help && <p id={helpId} class="field-help">{help}</p>}
  {error && <p id={errorId} class="field-error" role="alert">{error}</p>}
  {warning && <p id={warningId} class="field-warning">{warning}</p>}
</div>

<style>
  .field-limits, .field-help { margin: 0.375rem 0 0; font-size: 0.8rem; line-height: 1.5; color: var(--text-secondary); }
  .field { margin-bottom: 1rem; }
  .field-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 0.375rem;
  }
  .field-unit {
    font-weight: 400;
    color: var(--text-muted);
    margin-left: 0.25rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .req { color: var(--error); margin-left: 0.125rem; }
  .field-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    font-size: 1rem;
    font-family: var(--font-mono);
    color: var(--text-primary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-md);
    transition: border-color var(--transition), box-shadow var(--transition);
    -moz-appearance: textfield;
  }
  .field-input::-webkit-outer-spin-button,
  .field-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .field-input:hover { border-color: var(--text-muted); }
  .field-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  .field-input[aria-invalid="true"] { border-color: var(--error); }
  .field-input[aria-invalid="true"]:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.3); }
  .field-error {
    margin-top: 0.375rem;
    font-size: 0.8rem;
    color: var(--error);
  }
  .field-warning {
    margin-top: 0.375rem;
    font-size: 0.8rem;
    color: var(--warning);
  }
</style>
