---
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<article class="reference-page">
  <header><h1>{title}</h1><p>{description}</p></header>
  <slot />
</article>
<style>
  .reference-page { max-width: 800px; margin: 0 auto; padding: 2rem 1rem 3rem; }
  header { border-bottom: 1px solid var(--border-primary); padding-bottom: 1rem; margin-bottom: 2rem; }
  h1 { font-size: 1.75rem; }
  p { color: var(--text-secondary); }
  .reference-page :global(h2) { margin: 2rem 0 0.75rem; font-size: 1.2rem; }
  .reference-page :global(h3) { margin: 1.5rem 0 0.5rem; font-size: 1rem; }
  .reference-page :global(li) { margin-bottom: 0.5rem; color: var(--text-secondary); }
  .reference-page :global(code) { overflow-wrap: anywhere; }
</style>
