---
// UnitSelect.astro - Technical unit selector
interface Props {
  id: string;
  label: string;
  value: number | string;
  unit: string;
  options: { value: string; label: string }[];
  onChange?: string;
}
const { id, label, value, unit, options, onChange } = Astro.props;
---

<div class="unit-field">
  <label for={id} class="field-label">
    {label}
    <span class="req" aria-hidden="true">*</span>
  </label>
  <div class="unit-wrapper">
    <input
      type="number"
      id={id}
      name={id}
      value={value}
      class="field-input"
      step="any"
      min="0"
      required
    />
    <select id={`${id}-unit`} name={`${id}-unit`} class="unit-select" onchange={onChange}>
      {options.map(opt => (
        <option value={opt.value} selected={opt.value === unit}>
          {opt.label}
        </option>
      ))}
    </select>
  </div>
</div>

<style>
  .unit-field { margin-bottom: 1rem; }
  .field-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-bottom: 0.375rem;
  }
  .req { color: var(--error); margin-left: 0.125rem; }
  .unit-wrapper {
    display: flex;
    gap: 0.5rem;
  }
  .field-input {
    flex: 1;
    padding: 0.625rem 0.875rem;
    font-size: 1rem;
    font-family: var(--font-mono);
    color: var(--text-primary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-md);
    transition: border-color var(--transition), box-shadow var(--transition);
    -moz-appearance: textfield;
    min-width: 0;
  }
  .field-input::-webkit-outer-spin-button,
  .field-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .field-input:hover { border-color: var(--text-muted); }
  .field-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  .unit-select {
    padding: 0.625rem 0.75rem;
    font-size: 0.85rem;
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--radius-md);
    cursor: pointer;
    min-width: 80px;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .unit-select:hover { border-color: var(--text-muted); }
  .unit-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }
  @media (max-width: 480px) {
    .unit-wrapper { flex-direction: column; }
    .unit-select { width: 100%; }
  }
</style>