---
// CalculatorShell.astro - Instrument panel wrapper with client-side calculation
interface Props {
  title: string;
  description: string;
  calculatorId: string;
}
const { title, description, calculatorId } = Astro.props;
const directions: Record<string, string> = {
  'wheel-offset': 'Enter wheel width in inches and offset (ET) in millimeters for both wheels. A negative offset is allowed.',
  'compression-ratio': 'Choose inches or millimeters for bore, stroke, gasket, and deck dimensions. Enter chamber, dish, and dome volumes in cc.',
  'engine-displacement': 'Choose inches or millimeters for bore and stroke. Enter a whole-number cylinder count; results include cubic inches, liters, and cc.',
  'horsepower': 'Enter torque in lb-ft and engine speed in RPM, or select N·m for metric torque. Results show mechanical horsepower and kW.',
  'fuel-injector': 'Enter target horsepower and BSFC in lb/(hp·hr). Enter duty cycle as a decimal: 0.80 means 80%. Results show lb/hr and cc/min.',
  'power-to-weight': 'Enter horsepower and vehicle weight in pounds, or select metric units. A US ton is 2,000 lb.',
  'quarter-mile': 'Enter vehicle weight in pounds, including driver and carried load, and horsepower. Metric weight is also available; trap speed is in mph.',
  'tire-size': 'Read the tire sidewall: 225/45R17 means 225 mm section width, 45% aspect ratio, and a 17-inch rim. Speed comparisons use mph.',
};
---

<article class="calculator-page" data-calculator={calculatorId}>
  <header class="calc-header">
    <div class="calc-header-text">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>

  </header>

  <div class="calc-body">
    <section class="calc-inputs" aria-labelledby="inputs-heading">
      <h2 id="inputs-heading" class="visually-hidden">Calculator Inputs</h2>
      <p class="input-directions">{directions[calculatorId]}</p>
      <p class="input-note">Example inputs are prefilled. Follow the input limits below each field, then select Calculate. The address bar saves the inputs for sharing.</p>
      <noscript><p class="calculator-error-summary">Enable JavaScript to calculate with your own inputs. The formula and worked example are available below.</p></noscript>
      <slot name="inputs" />
    </section>
    <aside class="calc-results" aria-live="polite" aria-labelledby="results-heading">
      <h2 id="results-heading" class="visually-hidden">Results</h2>
      <slot name="results" />
    </aside>
  </div>

  <section class="calc-section" aria-labelledby="explanation-heading">
    <h2 id="explanation-heading">Formula & Method</h2>
    <slot name="explanation" />
  </section>

  <section class="calc-section" aria-labelledby="example-heading">
    <h2 id="example-heading">Worked Example</h2>
    <slot name="example" />
  </section>

  <section class="calc-section calc-limitations" aria-labelledby="limitations-heading">
    <h2 id="limitations-heading">Limitations</h2>
    <slot name="limitations" />
  </section>

  <section class="calc-section" aria-labelledby="related-heading">
    <h2 id="related-heading">Related Tools</h2>
    <slot name="related" />
  </section>
</article>

<style>
  .input-directions { font-size: 0.9rem; color: var(--text-primary); margin: 0 0 0.75rem; }
  .input-note { font-size: 0.85rem; color: var(--text-secondary); margin: 0 0 1rem; }
  :global(.calculator-field-error), :global(.calculator-error-summary) {
    color: var(--error);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  :global(.calculator-field-error) { margin-top: 0.375rem; }
  :global(.calculator-error-summary) {
    padding: 1rem;
    border: 1px solid var(--error);
    border-radius: var(--radius-md);
    margin: 0 0 1rem;
  }
  :global(.calculator-warning) { color: var(--accent); font-size: 0.85rem; }
  :global(.field-label .field-unit) { margin-left: 0.25rem; font-weight: 400; text-transform: none; }
  .calculator-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .calc-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-primary);
  }

  .calc-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .calc-header p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 65ch;
    margin: 0;
  }

  .calc-id {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-primary);
    white-space: nowrap;
  }

  .calc-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 900px) {
    .calc-body {
      grid-template-columns: 1fr 380px;
    }
  }

  .calc-inputs {
    background: var(--bg-panel);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .calc-results {
    background: var(--bg-secondary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    align-self: start;
  }
  @media (min-width: 900px) { .calc-results { position: sticky; top: 128px; } }
  @media (max-width: 480px) {
    .calc-inputs, .calc-results, .calc-section { padding: 1rem; }
    :global(.result-row) { flex-wrap: wrap; }
    :global(.result-row dt) { flex-shrink: 1; }
  }

  .calc-section {
    background: var(--bg-panel);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .calc-section h2 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-primary);
  }

  .calc-limitations {
    border-color: rgba(239, 68, 68, 0.3);
  }

  .calc-limitations h2 {
    color: var(--error);
  }
</style>
