---
import { toolCatalog } from '../lib/toolCatalog';
interface Props {
  title: string;
  description: string;
  calculatorId: string;
}
const { title, description, calculatorId } = Astro.props;
const tool = toolCatalog.find(tool => tool.id === calculatorId);
const directions: Record<string, string> = {
  'wheel-offset': 'Enter wheel width in inches and offset (ET) in millimeters for both wheels. A negative offset is allowed.',
  'compression-ratio': 'Choose inches or millimeters for bore, stroke, gasket, and deck dimensions. Enter chamber, dish, and dome volumes in cc.',
  'engine-displacement': 'Choose inches or millimeters for bore and stroke. Enter a whole-number cylinder count; results include cubic inches, liters, and cc.',
  'horsepower': 'Enter torque in lb-ft and engine speed in RPM, or select N·m for metric torque. Results show mechanical horsepower and kW.',
  'fuel-injector': 'Enter target horsepower and BSFC in lb/(hp·hr). Enter duty cycle as a decimal: 0.80 means 80%. Results show lb/hr and cc/min.',
  'power-to-weight': 'Enter horsepower and vehicle weight in pounds, or select metric units. A US ton is 2,000 lb.',
  'quarter-mile': 'Enter vehicle weight in pounds, including driver and carried load, and horsepower. Metric weight is also available; trap speed is in mph.',
  'tire-size': 'Read the tire sidewall: 225/45R17 means 225 mm section width, 45% aspect ratio, and a 17-inch rim. Speed comparisons use mph.',
};
---

<article class="calculator-page" data-calculator={calculatorId}>
  <header class="calc-header">
    <div class="calc-header-text">
      <p class="calc-breadcrumb"><a href="/">Workbench</a><span aria-hidden="true">/</span>{tool && <a href={tool.categoryUrl}>{tool.category}</a>}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <span class="module-number" aria-label={`Module ${tool?.number}`}>P{tool?.number}</span>
  </header>
  <nav class="calc-jump-links" aria-label="Calculator sections"><a href="#inputs-heading">Inputs</a><a href="#results-heading">Results</a><a href="#explanation-heading">Method</a><a href="#limitations-heading">Limitations</a></nav>

  <div class="calc-body">
    <section class="calc-inputs" aria-labelledby="inputs-heading">
      <h2 id="inputs-heading" class="panel-heading">Input variables <span>01 / INPUT</span></h2>
      <p class="input-directions">{directions[calculatorId]}</p>
      <p class="input-note">Example inputs are prefilled. Follow the input limits below each field, then select Calculate. The address bar saves the inputs for sharing.</p>
      <noscript><p class="calculator-error-summary">Enable JavaScript to calculate with your own inputs. The formula and worked example are available below.</p></noscript>
      <slot name="inputs" />
    </section>
    <aside class="calc-results" aria-live="polite" aria-labelledby="results-heading">
      <h2 id="results-heading" class="panel-heading">Calculated output <span>02 / RESULT</span></h2>
      <slot name="results" />
      <p class="result-footnote">Check the assumptions and limitations below before making changes to your vehicle.</p>
    </aside>
  </div>

  <section class="calc-section" aria-labelledby="explanation-heading">
    <h2 id="explanation-heading">Formula & Method</h2>
    <slot name="explanation" />
  </section>

  <section class="calc-section" aria-labelledby="example-heading">
    <h2 id="example-heading">Worked Example</h2>
    <slot name="example" />
  </section>

  <section class="calc-section calc-limitations" aria-labelledby="limitations-heading">
    <h2 id="limitations-heading">Limitations</h2>
    <slot name="limitations" />
  </section>

  <section class="calc-section" aria-labelledby="related-heading">
    <h2 id="related-heading">Related Tools</h2>
    <slot name="related" />
  </section>
</article>

<style>
  .calculator-page { padding: 26px; max-width: 1200px; margin: 0 auto; }
  .calc-header { display: flex; justify-content: space-between; align-items: start; gap: 18px; margin-bottom: 20px; }
  .calc-breadcrumb { display: flex; flex-wrap: wrap; gap: 9px; margin: 0 0 16px !important; font: 9px/1.6 var(--font-mono) !important; text-transform: uppercase; letter-spacing: .05em; }
  .calc-breadcrumb span { color: var(--border-secondary); }
  .calc-header h1 { font: 500 clamp(23px, 2.7vw, 32px)/1.25 var(--font-mono); letter-spacing: -.045em; margin-bottom: 12px; }
  .calc-header p { margin: 0; font-size: 13px; line-height: 1.7; color: var(--text-secondary); max-width: 72ch; }
  .module-number { border: 1px solid var(--border-primary); border-radius: 6px; padding: 8px 10px; color: var(--text-muted); font: 10px var(--font-mono); flex-shrink: 0; }
  .calc-jump-links { display: flex; flex-wrap: wrap; gap: 0; border-top: 1px solid var(--border-primary); border-bottom: 1px solid var(--border-primary); margin-bottom: 22px; }
  .calc-jump-links a { display: flex; align-items: center; padding: 0 16px; min-height: 40px; font: 9px var(--font-mono); text-transform: uppercase; letter-spacing: .04em; border-right: 1px solid var(--border-primary); }
  .calc-jump-links a:first-child { padding-left: 0; }
  .calc-jump-links a:last-child { border: 0; }
  .calc-body { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 18px; margin-bottom: 22px; align-items: start; }
  .calc-inputs, .calc-results, .calc-section { border: 1px solid var(--border-primary); border-radius: 12px; padding: 22px; min-width: 0; }
  .calc-inputs { background: var(--bg-panel); }
  .calc-results { background: var(--bg-secondary); }
  .input-directions { font-size: 13px; line-height: 1.65; margin: 0 0 10px; }
  .input-note { font-size: 11px; line-height: 1.65; color: var(--text-muted); margin: 0 0 22px; }
  .result-footnote { font: 10px/1.7 var(--font-mono); color: var(--text-muted); border-top: 1px solid var(--border-primary); padding-top: 14px; margin: 18px 0 0; }
  .calc-section { background: var(--bg-panel); margin-bottom: 16px; }
  .calc-section h2 { font: 10px/1.5 var(--font-mono); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-blue); padding-bottom: 12px; margin-bottom: 18px; border-bottom: 1px solid var(--border-primary); }
  .calc-section :global(p), .calc-section :global(li) { font-size: 13px; }
  .calc-section :global(.worked-example) { background: var(--bg-primary); }
  .calc-section :global(.limitations) { background: var(--bg-primary); border-color: var(--border-primary); }
  :global(.calculator-field-error), :global(.calculator-error-summary) { color: var(--error); font-size: 12px; line-height: 1.6; }
  :global(.calculator-field-error) { margin: 6px 0; }
  :global(.calculator-error-summary) { border: 1px solid var(--error); border-radius: 8px; padding: 14px; margin: 0 0 14px; background: #af283d06; }
  :global(.calculator-warning) { color: var(--warning); font-size: 12px; }
  @media (min-width: 1100px) {
    .calc-inputs :global(fieldset) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; }
    .calc-inputs :global(fieldset > select) { grid-column: 1 / -1; }
    .calc-inputs :global(.field) { min-width: 0; margin-bottom: 10px; }
  }
  @media (max-width: 1000px) { .calc-body { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 760px) { .calculator-page { padding: 20px 16px; } .calc-inputs, .calc-results, .calc-section { padding: 16px; } .calc-jump-links a { padding: 0 10px; font-size: 8px; } .module-number { display: none; } .calc-section :global(.result-row) { flex-wrap: wrap; } }
</style>
