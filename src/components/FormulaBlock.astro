---
// FormulaBlock.astro - Technical formula display
interface Props {
  title?: string;
  formula: string;
  variables: { symbol: string; name: string; unit?: string }[];
  notes?: string[];
}
const { title, formula, variables, notes = [] } = Astro.props;
---

<section class="formula-block">
  {title && <h3>{title}</h3>}
  <div class="formula-display">
    <pre><code>{formula}</code></pre>
  </div>
  {variables.length > 0 && (
    <dl class="formula-vars">
      {variables.map(v => (
        <div class="var-row">
          <dt><code>{v.symbol}</code></dt>
          <dd>{v.name}{v.unit && ` <span class="var-unit">({v.unit})</span>`}</dd>
        </div>
      ))}
    </dl>
  )}
  {notes.length > 0 && (
    <ul class="formula-notes">
      {notes.map(note => <li>{note}</li>)}
    </ul>
  )}
</section>

<style>
  .formula-block h3 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .formula-display {
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-md);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .formula-display code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--accent);
    white-space: pre;
  }
  .formula-vars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .var-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
  }
  .var-row dt code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  .var-row dd {
    margin: 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .var-unit { color: var(--text-muted); font-size: 0.75rem; }
  .formula-notes {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-left: 1.25rem;
    margin: 0;
  }
  .formula-notes li { margin-bottom: 0.25rem; }
</style>