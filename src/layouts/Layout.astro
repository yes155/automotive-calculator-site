---
// Shared instrument workbench layout
import '../styles/workbench.css';
import { toolCatalog, toolHref } from '../lib/toolCatalog';
import { siteUrl, indexable } from '../lib/site.mjs';
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  pageType?: string;
  breadcrumbs?: { name: string; url: string }[];
}
const { title, description, canonical, noIndex, pageType = 'website', breadcrumbs = [] } = Astro.props;
const pageUrl = canonical || Astro.url.pathname;
const fullCanonical = siteUrl ? new URL(pageUrl, siteUrl).toString() : undefined;
const fullDescription = description || 'Automotive calculators for wheels, tires, engine geometry, performance, and fueling.';
const ogImage = siteUrl ? `${siteUrl}/og-image.svg` : undefined;
const navItems = [
  { url: '/calculators/', name: 'All Calculators' },
  { url: '/wheels-tires/', name: 'Wheels & Tires' },
  { url: '/engine/', name: 'Engine' },
  { url: '/performance/', name: 'Performance' },
  { url: '/fueling/', name: 'Fueling' },
  { url: '/guides/', name: 'Guides' },
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={fullDescription} />
    {fullCanonical && <link rel="canonical" href={fullCanonical} />}
    {(noIndex || !indexable) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Automotive Calculators" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImage} />
    {siteUrl && <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Automotive Calculators',
      url: siteUrl,
    })} />}
    {siteUrl && breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.url, siteUrl).toString()
        }))
      })} />
    )}
    {siteUrl && pageType === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: fullDescription,
        author: { '@type': 'Organization', name: 'Automotive Calculators', url: siteUrl },
        publisher: { '@type': 'Organization', name: 'Automotive Calculators', url: siteUrl, logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` } },
        mainEntityOfPage: { '@type': 'WebPage', '@id': fullCanonical },
        image: ogImage
      })} />
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="site-frame">
      <header class="site-header">
        <a href="/" class="site-title" aria-label="Automotive Calculators Home">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>AUTO / CALC</span>
          <span class="brand-caption">AUTOMOTIVE WORKBENCH</span>
        </a>
        <nav class="header-links" aria-label="Resources">
          <span class="header-count">08 TOOLS / US UNITS</span>
          <a href="/guides/">Field notes ↗</a>
          <a href="/methodology/" class="method-link">Methodology ↗</a>
        </nav>
      </header>
      <div class="site-workspace">
        <aside class="site-sidebar" aria-label="Workbench navigation">
          <details class="tool-navigation" open>
            <summary>Tools & navigation</summary>
            <div class="nav-body">
              <p class="nav-heading">Calculator modules</p>
              <nav aria-label="Calculator tools">
                <ul class="tool-nav">
                  <li><a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}><span>00</span><span>Workbench</span></a></li>
                  {toolCatalog.map(tool => <li><a href={toolHref(tool.id)} aria-current={Astro.url.pathname === toolHref(tool.id) ? 'page' : undefined}><span>{tool.number}</span><span>{tool.name}</span></a></li>)}
                </ul>
              </nav>
              <hr class="sidebar-divider" />
              <p class="nav-heading">Explore the library</p>
              <nav aria-label="Main navigation">
                <ul class="category-nav">
                  {navItems.map(item => <li><a href={item.url} aria-current={Astro.url.pathname === item.url ? 'page' : undefined}>{item.name}</a></li>)}
                </ul>
              </nav>
              <p class="sidebar-note">Formulas included.<br />Assumptions explained.<br />Built for your next build.</p>
            </div>
          </details>
        </aside>
        <main id="main-content"><slot /></main>
      </div>
      <footer class="site-footer">
        <p>© 2026 AUTO / CALC · Automotive calculators. Formulas, units, and assumptions explained.</p>
        <nav aria-label="Footer navigation">
          <a href="/calculators/">Calculators</a>
          <a href="/guides/">Guides</a>
          <a href="/methodology/">Methodology</a>
          <a href="/about/">About</a>
        </nav>
      </footer>
    </div>
    <script>
      const navigation = document.querySelector<HTMLDetailsElement>('.tool-navigation');
      const compact = window.matchMedia('(max-width: 760px)');
      const updateNavigation = () => { if (navigation) navigation.open = !compact.matches; };
      updateNavigation();
      compact.addEventListener('change', updateNavigation);
    </script>
  </body>
</html>
