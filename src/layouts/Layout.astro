---
// Layout.astro - Technical Service Manual design system
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  pageType?: string;
  breadcrumbs?: { name: string; url: string }[];
}
const { title, description, canonical, noIndex, pageType = 'website', breadcrumbs = [] } = Astro.props;
const siteUrl = 'https://autocalc.example.com';
const pageUrl = canonical || Astro.url.pathname;
const fullCanonical = new URL(pageUrl, siteUrl).toString();
const fullDescription = description || 'Automotive calculators for wheels, tires, engine geometry, performance, and fueling.';
const ogImage = `${siteUrl}/og-image.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={fullDescription} />
    <link rel="canonical" href={fullCanonical} />
    {noIndex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Automotive Calculators" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Automotive Calculators',
      url: siteUrl,
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/calculators/?q={search_term_string}` },
        'query-input': 'required name=search_term_string'
      }
    })} />
    {breadcrumbs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.url, siteUrl).toString()
        }))
      })} />
    )}
    {pageType === 'article' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: fullDescription,
        author: { '@type': 'Organization', name: 'Automotive Calculators', url: siteUrl },
        publisher: { '@type': 'Organization', name: 'Automotive Calculators', url: siteUrl, logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` } },
        mainEntityOfPage: { '@type': 'WebPage', '@id': fullCanonical },
        image: ogImage
      })} />
    )}
    <style is:global>
      :root {
        --bg-primary: #1a1a1a;
        --bg-secondary: #242424;
        --bg-tertiary: #2d2d2d;
        --bg-panel: #1f1f1f;
        --border-primary: #3a3a3a;
        --border-secondary: #4a4a4a;
        --text-primary: #e8e8e8;
        --text-secondary: #b0b0b0;
        --text-muted: #808080;
        --accent: #f59e0b;
        --accent-hover: #d97706;
        --accent-dim: rgba(245, 158, 11, 0.15);
        --accent-glow: rgba(245, 158, 11, 0.3);
        --success: #22c55e;
        --error: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', 'SF Mono', 'Monaco', 'Inconsolata', monospace;
        --radius-sm: 4px;
        --radius-md: 6px;
        --radius-lg: 8px;
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
        --shadow-md: 0 4px 12px rgba(0,0,0,0.4);
        --shadow-lg: 0 8px 24px rgba(0,0,0,0.5);
        --transition: 150ms cubic-bezier(0.4, 0, 0.2, 1);
      }

      * { box-sizing: border-box; }
      html { font-size: 16px; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: var(--font-sans);
        line-height: 1.6;
        color: var(--text-primary);
        background: var(--bg-primary);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; transition: color var(--transition); }
      a:hover { color: var(--accent-hover); text-decoration: underline; }
      a:focus { outline: none; box-shadow: 0 0 0 3px var(--accent-glow); border-radius: var(--radius-sm); }
      h1, h2, h3, h4 { line-height: 1.3; color: var(--text-primary); margin: 0; }
      code, pre { font-family: var(--font-mono); }
      ::selection { background: var(--accent); color: var(--bg-primary); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .skip-link {
        position: absolute; top: -100%; left: 1rem;
        padding: 0.75rem 1rem; background: var(--accent); color: var(--bg-primary);
        border-radius: 0 0 var(--radius-md) var(--radius-md); z-index: 100;
        font-weight: 600; transition: top 0.2s;
      }
      .skip-link:focus { top: 0; }

      .visually-hidden {
        position: absolute; width: 1px; height: 1px;
        padding: 0; margin: -1px; overflow: hidden;
        clip: rect(0,0,0,0); white-space: nowrap; border: 0;
      }

      .result-panel { padding: 0; }
      .result-primary {
        text-align: center;
        padding: 1.5rem 1rem;
        background: var(--bg-tertiary);
        border: 1px solid var(--border-primary);
        border-radius: var(--radius-md);
        margin-bottom: 1rem;
      }
      .result-value {
        display: block;
        font-family: var(--font-mono);
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--accent);
        line-height: 1.2;
        word-break: break-word;
      }
      .result-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-top: 0.375rem;
      }
      .result-secondary { margin-bottom: 1rem; }
      .result-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border-primary);
        gap: 0.5rem;
      }
      .result-row:last-child { border-bottom: none; }
      .result-row dt {
        font-size: 0.8rem;
        color: var(--text-secondary);
        flex-shrink: 0;
      }
      .result-row dd {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text-primary);
        text-align: right;
        word-break: break-word;
      }
      .result-interpretation {
        padding: 1rem;
        background: var(--accent-dim);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: var(--radius-md);
        font-size: 0.85rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin: 0;
      }
    </style>
  </head>
  <body>
    <!-- DIRECTION CONTRACT: THESIS: Calculator as instrument panel in a technical service manual. OWN-WORLD: Dark charcoal ground, safety orange accent, technical monospace for measurements, spec-table density, panel chrome, dither textures. STORY: User enters measurements, gets precise result with interpretation, verifies formula, moves to related tools. FIRST VIEWPORT: Calculator panel with inputs left, results right, formula below. FORM: Technical Service Manual (grounded #4). FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header" role="banner">
      <div class="header-inner">
        <a href="/" class="site-title" aria-label="Automotive Calculators Home">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="2" y="2" width="24" height="24" rx="4" stroke="var(--accent)" stroke-width="2"/>
            <circle cx="14" cy="14" r="6" stroke="var(--accent)" stroke-width="2"/>
            <path d="M14 8V20M8 14H20" stroke="var(--accent)" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>Automotive Calculators</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <ul>
            <li><a href="/calculators/">All Calculators</a></li>
            <li><a href="/wheels-tires/">Wheels & Tires</a></li>
            <li><a href="/engine/">Engine</a></li>
            <li><a href="/performance/">Performance</a></li>
            <li><a href="/fueling/">Fueling</a></li>
            <li><a href="/guides/">Guides</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" role="main" style="flex: 1;">
      <slot />
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="footer-inner">
        <p>&copy; 2026 Automotive Calculators. Built for enthusiasts, by enthusiasts.</p>
        <nav aria-label="Footer navigation">
          <a href="/calculators/">Calculators</a> &middot;
          <a href="/guides/">Guides</a> &middot;
          <a href="#">Privacy</a> &middot;
          <a href="#">About</a>
        </nav>
      </div>
    </footer>

    <style>
      .header-inner, .footer-inner {
        max-width: 1100px; margin: 0 auto; padding: 0 1rem;
      }
      .site-header {
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border-primary);
        position: sticky; top: 0; z-index: 50;
      }
      .header-inner {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; height: 56px;
      }
      .site-title {
        font-size: 1rem; font-weight: 700; color: var(--text-primary);
        text-decoration: none; display: flex; align-items: center; gap: 0.5rem;
        letter-spacing: -0.01em;
      }
      .site-title:hover { color: var(--accent); text-decoration: none; }
      .main-nav ul {
        display: flex; flex-wrap: wrap; gap: 0.25rem; list-style: none; margin: 0; padding: 0;
      }
      .main-nav a {
        font-size: 0.8rem; font-weight: 500; color: var(--text-secondary);
        padding: 0.375rem 0.75rem; border-radius: var(--radius-sm);
        border: 1px solid transparent; transition: all var(--transition);
        text-transform: uppercase; letter-spacing: 0.05em;
      }
      .main-nav a:hover {
        color: var(--accent); border-color: var(--border-primary);
        text-decoration: none; background: var(--bg-tertiary);
      }
      .main-nav a[aria-current="page"] {
        color: var(--accent); border-color: var(--accent); background: var(--accent-dim);
      }
      .site-footer {
        background: var(--bg-secondary); color: var(--text-muted);
        border-top: 1px solid var(--border-primary); margin-top: auto;
      }
      .footer-inner {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; padding: 1.5rem 1rem;
      }
      .footer-inner p { margin: 0; font-size: 0.8rem; }
      .site-footer nav { display: flex; flex-wrap: wrap; gap: 0.75rem; }
      .site-footer a { color: var(--text-muted); font-size: 0.8rem; }
      .site-footer a:hover { color: var(--accent); }
      @media (max-width: 640px) {
        .header-inner { height: auto; padding: 0.75rem 1rem; flex-direction: column; align-items: flex-start; }
        .main-nav ul { gap: 0.125rem; }
        .main-nav a { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
        .footer-inner { flex-direction: column; text-align: center; }
      }
    </style>
  </body>
</html>