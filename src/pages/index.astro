---
import Layout from '../layouts/Layout.astro';
import ToolArtwork from '../components/ToolArtwork.astro';
import { toolCatalog, toolHref } from '../lib/toolCatalog';
const guides = [
  { title: 'Wheel offset, explained', href: '/guides/wheel-offset-explained/', category: 'FITMENT' },
  { title: 'Compression ratio, explained', href: '/guides/compression-ratio-explained/', category: 'ENGINE' },
  { title: 'Bore vs. stroke', href: '/guides/bore-vs-stroke/', category: 'GEOMETRY' },
  { title: 'Horsepower vs. torque', href: '/guides/horsepower-vs-torque/', category: 'POWER' },
  { title: 'BSFC, explained', href: '/guides/bsfc-explained/', category: 'FUELING' },
];
---
<Layout title="Automotive Calculators" description="Fast, trustworthy automotive calculators for wheels, tires, engine geometry, performance, and fueling. Built for DIY enthusiasts, tuners, and builders.">
  <div class="workbench-home">
    <header class="workbench-header">
      <div><p class="eyebrow">MEASURE / COMPARE / UNDERSTAND</p><h1>Automotive calculators</h1></div>
      <a href="/calculators/" class="index-link">View tool index ↗</a>
    </header>
    <section class="module-workbench" aria-label="Calculator workbench">
      <div class="intro-module">
        <div class="drafting-pad">
          <div class="drafting-label"><span>THE WORKBENCH</span><span>01—08</span></div>
          <div class="wheel-drawing"><ToolArtwork id="wheel-offset" large /></div>
          <div class="drafting-caption"><span>INCHES · MILLIMETERS · HORSEPOWER</span><span>MEASURE TWICE. BUILD ONCE.</span></div>
        </div>
        <div class="intro-copy">
          <p class="eyebrow">A LITTLE MATH. A BETTER BUILD.</p>
          <h2>Your next move,<br />calculated.</h2>
          <p>Check the numbers before you change the parts. Eight focused tools for your garage, build sheet, and next what-if.</p>
          <a href="/calculators/wheel-offset/" class="btn-primary">Start with wheel offset <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="tool-bank">
        <div class="bank-heading"><h2>Choose a module</h2><span>08 CALCULATORS</span></div>
        <div class="module-grid">
          {toolCatalog.map(tool => (
            <a href={toolHref(tool.id)} class="module-card">
              <div class="module-art"><span class="module-category">{tool.category}</span><ToolArtwork id={tool.id} /><span class="module-units">{tool.units}</span></div>
              <div class="module-copy"><h3>{tool.name}</h3><p>{tool.description}</p></div>
              <div class="module-bottom"><span><i aria-hidden="true"></i> P{tool.number}</span><span aria-hidden="true">↗</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
    <section class="method-strip" aria-label="How to use the calculators">
      <span class="strip-title">YOUR BUILD, IN NUMBERS</span>
      <p><span>01</span> Enter your measurements <span class="strip-dash">/</span> <span>02</span> Calculate and compare <span class="strip-dash">/</span> <span>03</span> Check the assumptions</p>
      <a href="/methodology/">Read the method ↗</a>
    </section>
    <section class="field-notes" aria-labelledby="guides-heading">
      <div class="notes-heading"><h2 id="guides-heading">Field notes</h2><a href="/guides/">All technical guides ↗</a></div>
      <div class="notes-grid">{guides.map((guide, index) => <a href={guide.href} class="note-card"><span class="note-index">F0{index + 1} / {guide.category}</span><h3>{guide.title}</h3><span class="note-arrow" aria-hidden="true">↗</span></a>)}</div>
    </section>
  </div>
</Layout>
<style>
  .workbench-home { padding: 26px; }
  .workbench-header { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .workbench-header .eyebrow { margin: 0 0 8px; font-size: 9px; }
  h1 { font-size: clamp(24px, 2.6vw, 34px); font-weight: 500; letter-spacing: -.05em; }
  .index-link { font: 10px var(--font-mono); white-space: nowrap; padding-bottom: 5px; }
  .module-workbench { display: grid; grid-template-columns: minmax(240px, .85fr) minmax(0, 2fr); gap: 20px; }
  .intro-module { border: 1px solid var(--border-primary); border-radius: 13px; overflow: hidden; display: flex; flex-direction: column; }
  .drafting-pad { background: radial-gradient(#b0bccb .7px, transparent .7px) 5px 5px / 18px 18px, var(--bg-primary); display: flex; flex: 1; flex-direction: column; min-height: 275px; padding: 18px; }
  .drafting-label { display: flex; justify-content: space-between; gap: 8px; font: 9px var(--font-mono); letter-spacing: .08em; color: var(--text-muted); }
  .wheel-drawing { margin: auto 0; padding: 22px 0; }
  .drafting-caption { display: grid; gap: 6px; font: 8px/1.5 var(--font-mono); letter-spacing: .05em; text-align: center; color: var(--text-muted); }
  .intro-copy { padding: 22px; border-top: 1px solid var(--border-primary); }
  .intro-copy .eyebrow { font-size: 8px; margin: 0 0 12px; }
  .intro-copy h2 { font-size: clamp(23px, 2.4vw, 31px); letter-spacing: -.05em; font-weight: 500; line-height: 1.2; }
  .intro-copy > p:not(.eyebrow) { font-size: 13px; color: var(--text-secondary); line-height: 1.7; margin: 14px 0 20px; }
  .intro-copy .btn-primary { width: 100%; justify-content: space-between; text-align: left; font-size: 10px; padding: 13px; }
  .tool-bank { min-width: 0; }
  .bank-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .bank-heading h2, .bank-heading > span { font: 9px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); }
  .module-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .module-card { color: var(--text-primary); border: 1px solid var(--border-primary); border-radius: 11px; overflow: hidden; display: flex; flex-direction: column; transition: border-color var(--transition), background var(--transition); }
  .module-card:hover { text-decoration: none; border-color: var(--text-primary); background: var(--bg-primary); }
  .module-art { background: repeating-linear-gradient(45deg, transparent 0 3px, #52627a08 3px 4px), var(--bg-primary); padding: 12px 8px; display: flex; flex-direction: column; align-items: center; gap: 8px; border-bottom: 1px solid var(--border-primary); }
  .module-category { font: 7px/1.5 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; color: var(--text-muted); text-align: center; }
  .module-units { font: 8px var(--font-mono); color: var(--ink-blue); }
  .module-copy { padding: 12px 10px; flex: 1; }
  .module-copy h3 { font: 11px/1.4 var(--font-mono); letter-spacing: -.02em; }
  .module-copy p { font-size: 10px; line-height: 1.6; color: var(--text-secondary); margin: 8px 0 0; }
  .module-bottom { display: flex; justify-content: space-between; align-items: center; padding: 7px 10px; border-top: 1px solid var(--border-primary); font: 9px var(--font-mono); }
  .module-bottom > span:first-child { display: flex; align-items: center; gap: 6px; }
  .module-bottom i { width: 6px; height: 6px; border: 1px solid var(--border-secondary); }
  .module-card:hover .module-bottom i { background: var(--text-primary); border-color: var(--text-primary); }
  .method-strip { border: 1px solid var(--border-primary); border-radius: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 20px; padding: 14px 16px; }
  .strip-title { font: 9px var(--font-mono); letter-spacing: .05em; }
  .method-strip p { margin: 0; font: 10px/1.8 var(--font-mono); color: var(--text-secondary); }
  .method-strip p span:not(.strip-dash) { color: var(--text-muted); font-size: 8px; }
  .strip-dash { margin: 0 8px; color: var(--border-secondary); }
  .method-strip a { font: 9px var(--font-mono); }
  .field-notes { margin-top: 28px; }
  .notes-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .notes-heading h2 { font: 11px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .notes-heading a { font: 9px var(--font-mono); }
  .notes-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .note-card { position: relative; border: 1px solid var(--border-primary); border-radius: 8px; padding: 14px 12px 30px; color: var(--text-primary); }
  .note-card:hover { background: var(--bg-primary); border-color: var(--border-secondary); text-decoration: none; }
  .note-index { font: 7px var(--font-mono); letter-spacing: .05em; color: var(--text-muted); }
  .note-card h3 { margin-top: 12px; font: 11px/1.6 var(--font-mono); }
  .note-arrow { position: absolute; right: 12px; bottom: 8px; font: 12px var(--font-mono); }
  @media (max-width: 1120px) { .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .module-art { padding: 8px; gap: 2px; } .module-copy p { font-size: 11px; } .notes-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 980px) { .module-workbench { grid-template-columns: minmax(200px, .8fr) minmax(0, 1.2fr); gap: 14px; } .intro-copy { padding: 18px; } .module-copy h3 { font-size: 10px; } }
  @media (max-width: 760px) { .workbench-home { padding: 20px 16px; } .workbench-header { align-items: start; } .index-link { display: none; } .module-workbench { grid-template-columns: 1fr; } .intro-module { display: grid; grid-template-columns: 1fr 1fr; } .drafting-pad { min-height: 240px; } .intro-copy { border-top: 0; border-left: 1px solid var(--border-primary); } .module-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } .module-copy p { font-size: 10px; } .notes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .intro-module { display: flex; } .drafting-pad { min-height: 200px; flex: auto; } .wheel-drawing { width: 200px; max-width: 100%; margin: auto; padding: 10px 0; } .intro-copy { border-left: 0; border-top: 1px solid var(--border-primary); } .intro-copy h2 br { display: none; } .intro-copy h2 { font-size: 26px; } .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .module-copy h3 { font-size: 11px; } .method-strip { padding: 14px; } .method-strip p { display: grid; grid-template-columns: 18px 1fr; gap: 4px; } .strip-dash { display: none; } }
</style>
