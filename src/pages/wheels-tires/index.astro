---
import Layout from '../../layouts/Layout.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout title="Wheels & Tires Calculators" description="Wheel and tire calculators for fitment, offset, and size comparison.">
  <section class="hub-page">
    <header>
      <h1>Wheels & Tires</h1>
      <p>Tools for wheel fitment, offset comparison, and tire size analysis.</p>
    </header>
    <RelatedTools tools={[
      { title: 'Wheel Offset Calculator', href: '/calculators/wheel-offset/', description: 'Compare inner clearance and outer poke when changing wheels' },
      { title: 'Tire Size Calculator', href: '/calculators/tire-size/', description: 'Compare tire diameters, circumference, and speedometer effect' },
    ]} />
    <div class="hub-section">
      <h2>Related Guides</h2>
      <RelatedTools tools={[
        { title: 'Wheel Offset Explained', href: '/guides/wheel-offset-explained/', description: 'Positive, zero, negative offset and how width interacts' },
        { title: 'How to Read Tire Size', href: '/guides/how-to-read-tire-size/', description: 'Decoding P-metric, LT, and Euro-metric tire codes (Phase 2)' },
        { title: 'Tire Diameter vs Wheel Size', href: '/guides/tire-diameter-vs-wheel-size/', description: 'Plus-sizing, aspect ratio, and ride quality (Phase 2)' },
      ]} />
    </div>
  </section>
</Layout>

<style>
  .hub-page { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }
  .hub-page header { margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-primary); }
  .hub-page h1 { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
  .hub-page header p { color: var(--text-secondary); font-size: 0.95rem; }
  .hub-section { margin-top: 2rem; }
  .hub-section h2 { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-primary); }
</style>