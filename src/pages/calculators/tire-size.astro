---
import Layout from '../../layouts/Layout.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import NumberField from '../../components/NumberField.astro';
import ResultCard from '../../components/ResultCard.astro';
import FormulaBlock from '../../components/FormulaBlock.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import { calculateTireSize, validateTireSize, type TireSizeInput } from '../../lib/calculators/tireSize.ts';

const url = new URL(Astro.url);
const tireAWidth = parseFloat(url.searchParams.get('tireAWidth') || '225');
const tireAAspect = parseFloat(url.searchParams.get('tireAAspect') || '45');
const tireARim = parseFloat(url.searchParams.get('tireARim') || '17');
const tireBWidth = parseFloat(url.searchParams.get('tireBWidth') || '235');
const tireBAspect = parseFloat(url.searchParams.get('tireBAspect') || '40');
const tireBRim = parseFloat(url.searchParams.get('tireBRim') || '18');
const input: TireSizeInput = { tireAWidth, tireAAspect, tireARim, tireBWidth, tireBAspect, tireBRim };
const validation = validateTireSize(input);
const result = calculateTireSize(input);
const canonical = '/calculators/tire-size/';

const fmt = (n, d = 1) => {
  if (!isFinite(n)) return '—';
  const f = Math.pow(10, d);
  return (Math.round(Math.abs(n) * f) / f * Math.sign(n)).toFixed(d);
};
const fmtSigned = (n, d = 1) => {
  if (!isFinite(n)) return '—';
  const v = Math.round(Math.abs(n) * Math.pow(10, d)) / Math.pow(10, d);
  return (n >= 0 ? '+' : '-') + v.toFixed(d);
};

const speedo60 = result.comparison.speedometerReadingAt60;
const speedoErr = result.comparison.speedometerErrorPct;
const speedoLabel = `Speedometer reads ${Math.abs(speedoErr).toFixed(1)}% ${speedoErr > 0 ? 'high' : 'low'}: 60 shown = ${speedo60.toFixed(1)} actual`;

const verdict = result.comparison.verdict;
const verdictText = verdict === 'ok' ? 'Within common 3% tolerance' : verdict === 'caution' ? 'Caution: 3–5% difference' : 'Not recommended: >5% difference';
const verdictClass = verdict === 'ok' ? 'verdict-ok' : verdict === 'caution' ? 'verdict-warn' : 'verdict-bad';
---

<Layout title="Tire Size Calculator: Compare Diameter, Speedometer Error & Fitment" description="Compare two tire sizes: diameter, circumference, ground clearance change, and speedometer effect. Enter width, aspect ratio, and rim diameter for both tires." canonical={canonical} pageType="article" breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Calculators', url: '/calculators/' }, { name: 'Tire Size Calculator', url: '/calculators/tire-size/' }]}>
  <CalculatorShell title="Tire Size Calculator" description="Compare tire dimensions and speedometer effect. Enter section width (mm), aspect ratio (%), and wheel diameter (inches) for both tires." calculatorId="tire-size">
    <form method="POST" enctype="application/x-www-form-urlencoded" slot="inputs" novalidate data-calculator="tire-size">
      <fieldset>
        <legend>Tire A (Current / Reference)</legend>
        <NumberField id="tireAWidth" label="Section Width (mm)" value={tireAWidth} min={155} max={400} step={5} error={validation.errors.find(e => e.includes('Tire A width'))} warning={validation.warnings.find(w => w.includes('Tire A width'))} placeholder="e.g., 225" />
        <NumberField id="tireAAspect" label="Aspect Ratio (%)" value={tireAAspect} min={25} max={85} step={5} error={validation.errors.find(e => e.includes('Tire A aspect'))} warning={validation.warnings.find(w => w.includes('Tire A aspect'))} placeholder="e.g., 45" />
        <NumberField id="tireARim" label="Rim Diameter (inches)" value={tireARim} min={13} max={24} step={1} error={validation.errors.find(e => e.includes('Tire A rim'))} warning={validation.warnings.find(w => w.includes('Tire A rim'))} placeholder="e.g., 17" />
      </fieldset>
      <fieldset>
        <legend>Tire B (Proposed / Comparison)</legend>
        <NumberField id="tireBWidth" label="Section Width (mm)" value={tireBWidth} min={155} max={400} step={5} error={validation.errors.find(e => e.includes('Tire B width'))} warning={validation.warnings.find(w => w.includes('Tire B width'))} placeholder="e.g., 235" />
        <NumberField id="tireBAspect" label="Aspect Ratio (%)" value={tireBAspect} min={25} max={85} step={5} error={validation.errors.find(e => e.includes('Tire B aspect'))} warning={validation.warnings.find(w => w.includes('Tire B aspect'))} placeholder="e.g., 40" />
        <NumberField id="tireBRim" label="Rim Diameter (inches)" value={tireBRim} min={13} max={24} step={1} error={validation.errors.find(e => e.includes('Tire B rim'))} warning={validation.warnings.find(w => w.includes('Tire B rim'))} placeholder="e.g., 18" />
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn-primary">Calculate</button>
        <a href="/calculators/tire-size/" class="btn-secondary">Reset</a>
      </div>
    </form>

    <div class="result-panel" role="status" aria-live="polite">
      <div class="verdict-badge {verdictClass}">{verdictText}</div>
      <div class="result-primary">
        <span class="result-value">{fmtSigned(result.comparison.diameterDiffMm)} mm ({fmtSigned(result.comparison.diameterDiffPct)}%)</span>
        <span class="result-label">Diameter Difference</span>
      </div>
      <dl class="result-secondary">
        <div class="result-row"><dt>Tire A Diameter</dt><dd>{fmt(result.tireA.diameterIn, 2)} in ({fmt(result.tireA.diameterMm)} mm)</dd></div>
        <div class="result-row"><dt>Tire B Diameter</dt><dd>{fmt(result.tireB.diameterIn, 2)} in ({fmt(result.tireB.diameterMm)} mm)</dd></div>
        <div class="result-row"><dt>Circumference Diff</dt><dd>{fmtSigned(result.comparison.circumferenceDiffMm)} mm ({fmtSigned(result.comparison.circumferenceDiffPct)}%)</dd></div>
        <div class="result-row"><dt>Ground Clearance</dt><dd>{fmtSigned(result.comparison.groundClearanceChangeMm)} mm</dd></div>
        <div class="result-row"><dt>Revs per Mile (A / B)</dt><dd>{Math.round(result.tireA.revsPerMile).toLocaleString()} / {Math.round(result.tireB.revsPerMile).toLocaleString()}</dd></div>
        <div class="result-row"><dt>Revs per Km (A / B)</dt><dd>{Math.round(result.tireA.revsPerKm).toLocaleString()} / {Math.round(result.tireB.revsPerKm).toLocaleString()}</dd></div>
        <div class="result-row"><dt>Speedometer at 60</dt><dd>{fmt(speedo60)} MPH actual</dd></div>
        <div class="result-row"><dt>Speedometer</dt><dd>{speedoLabel}</dd></div>
      </dl>
      <div class="speedo-table">
        <h4>Speedometer Table</h4>
        <table>
          <thead><tr><th>Indicated (MPH)</th><th>Actual (MPH)</th></tr></thead>
          <tbody>
            <tr><td>30</td><td>{fmt(result.comparison.speedometerReadingAt30)}</td></tr>
            <tr><td>45</td><td>{fmt(result.comparison.speedometerReadingAt45)}</td></tr>
            <tr><td>60</td><td>{fmt(result.comparison.speedometerReadingAt60)}</td></tr>
            <tr><td>70</td><td>{fmt(result.comparison.speedometerReadingAt70)}</td></tr>
            <tr><td>80</td><td>{fmt(result.comparison.speedometerReadingAt80)}</td></tr>
          </tbody>
        </table>
      </div>
      <p class="result-interpretation">{result.interpretation}</p>
    </div>

    <FormulaBlock slot="explanation" title="Formula" formula={`sidewall_mm = section_width_mm × aspect_ratio / 100
diameter_mm = 2 × sidewall_mm + rim_in × 25.4
circumference_mm = π × diameter_mm
revs_per_mile = 63360 / (π × diameter_in)
diameter_diff_mm = diameter_B - diameter_A
diameter_diff_pct = (diameter_diff / diameter_A) × 100
ground_clearance_change = diameter_diff / 2
actual_speed = indicated_speed × diameter_B / diameter_A
speedometer_error_pct = (diameter_A / diameter_B − 1) × 100`} variables={[
      { symbol: 'section_width_mm', name: 'Tire section width', unit: 'mm' },
      { symbol: 'aspect_ratio', name: 'Aspect ratio (sidewall/width)', unit: '%' },
      { symbol: 'rim_in', name: 'Wheel/rim diameter', unit: 'inches' },
      { symbol: 'sidewall_mm', name: 'Sidewall height', unit: 'mm' },
      { symbol: 'diameter_mm', name: 'Overall tire diameter', unit: 'mm' },
      { symbol: 'circumference_mm', name: 'Tire circumference', unit: 'mm' },
    ]} notes={[
      'Calculations use nominal tire dimensions — actual mounted dimensions vary by tire model, rim width, inflation pressure, and load.',
      'Ground clearance change = diameter difference / 2 (radius change).',
      'Speedometer error: positive % means the speedometer reads HIGH (you travel slower than indicated); negative means it reads LOW.',
      'At 60 MPH indicated: actual = 60 × (diameter_B / diameter_A).',
      'Revs/mile useful for transmission/gearing calculations.',
    ]} />

    <div slot="example" class="worked-example">
      <p><strong>Example:</strong> 225/45R17 vs 235/40R18 (common plus-one sizing)</p>
      <ul>
        <li><strong>Tire A:</strong> 225 × 0.45 = 101.25 mm sidewall; 2×101.25 + 17×25.4 = <strong>634.3 mm (24.97″)</strong></li>
        <li><strong>Tire B:</strong> 235 × 0.40 = 94.0 mm sidewall; 2×94.0 + 18×25.4 = <strong>645.2 mm (25.40″)</strong></li>
        <li><strong>Difference:</strong> +10.9 mm (+1.7%) diameter; +5.5 mm ground clearance</li>
        <li><strong>Speedometer:</strong> At 60 MPH indicated, actual = 60 × 645.2 / 634.3 = <strong>61.0 MPH</strong> (speedometer reads 1.7% low)</li>
      </ul>
    </div>

    <div slot="limitations" class="limitations">
      <p><strong>Notes &amp; limitations:</strong></p>
      <ul>
        <li><strong>Nominal vs actual:</strong> Stated dimensions can differ from measured by ±2–3% due to tire model, construction, rim width, pressure, load, and wear.</li>
        <li><strong>Section width</strong> is measured on design rim width — actual width changes with rim width.</li>
        <li><strong>Aspect ratio</strong> is calculated at design load and pressure.</li>
        <li><strong>Speedometer calibration</strong> assumes original tire was correct — if already off, error compounds.</li>
        <li><strong>Does not check:</strong> fender clearance, suspension travel, brake caliper clearance, load rating, speed rating.</li>
        <li>Always verify fitment with actual mounted measurements before purchasing.</li>
      </ul>
    </div>

    <RelatedTools slot="related" tools={[
      { title: 'Wheel Offset Calculator', href: '/calculators/wheel-offset/', description: 'Check inner/outer clearance when changing wheels' },
      { title: 'Wheels & Tires Hub', href: '/wheels-tires/', description: 'All wheel and tire tools' },
    ]} />
  </CalculatorShell>
</Layout>

<script is:inline>
  function calculateTireSizeClient(aW, aA, aR, bW, bA, bR) {
    var INCH_TO_MM = 25.4;
    var aSidewall = aW * aA / 100;
    var aDiaMm = 2 * aSidewall + aR * INCH_TO_MM;
    var aDiaIn = aDiaMm / INCH_TO_MM;
    var aCirc = Math.PI * aDiaMm;
    var bSidewall = bW * bA / 100;
    var bDiaMm = 2 * bSidewall + bR * INCH_TO_MM;
    var bDiaIn = bDiaMm / INCH_TO_MM;
    var bCirc = Math.PI * bDiaMm;
    var diaDiffMm = bDiaMm - aDiaMm;
    var diaDiffPct = (diaDiffMm / aDiaMm) * 100;
    var circDiffMm = bCirc - aCirc;
    var circDiffPct = (circDiffMm / aCirc) * 100;
    var gcChange = diaDiffMm / 2;
    var speedoErrorPct = (aDiaMm / bDiaMm - 1) * 100;
    var speedo60 = 60 * (bDiaMm / aDiaMm);
    var speedo30 = 30 * (bDiaMm / aDiaMm);
    var speedo45 = 45 * (bDiaMm / aDiaMm);
    var speedo70 = 70 * (bDiaMm / aDiaMm);
    var speedo80 = 80 * (bDiaMm / aDiaMm);
    var aRevsMile = 63360 / aCirc;
    var bRevsMile = 63360 / bCirc;
    var aRevsKm = 1000000 / aCirc;
    var bRevsKm = 1000000 / bCirc;
    var absPct = Math.abs(diaDiffPct);
    var verdict = absPct <= 3 ? 'ok' : absPct <= 5 ? 'caution' : 'not_recommended';
    return {
      tireA: { diameterMm: aDiaMm, diameterIn: aDiaIn, circumferenceMm: aCirc, revsPerMile: aRevsMile, revsPerKm: aRevsKm },
      tireB: { diameterMm: bDiaMm, diameterIn: bDiaIn, circumferenceMm: bCirc, revsPerMile: bRevsMile, revsPerKm: bRevsKm },
      comparison: {
        diameterDiffMm: diaDiffMm, diameterDiffPct: diaDiffPct,
        circumferenceDiffMm: circDiffMm, circumferenceDiffPct: circDiffPct,
        groundClearanceChangeMm: gcChange, speedometerErrorPct: speedoErrorPct,
        speedometerReadingAt30: speedo30, speedometerReadingAt45: speedo45,
        speedometerReadingAt60: speedo60, speedometerReadingAt70: speedo70,
        speedometerReadingAt80: speedo80, verdict: verdict
      }
    };
  }
  function fmt(n, d) {
    if (!isFinite(n)) return '—';
    d = d || 1;
    var f = Math.pow(10, d);
    var v = Math.round(Math.abs(n) * f) / f;
    return (n < 0 ? '-' : '') + v.toFixed(d);
  }
  function fmtSigned(n, d) {
    if (!isFinite(n)) return '—';
    d = d || 1;
    var v = Math.round(Math.abs(n) * Math.pow(10, d)) / Math.pow(10, d);
    return (n >= 0 ? '+' : '-') + v.toFixed(d);
  }
  var form = document.querySelector('form[data-calculator="tire-size"]');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var fd = new FormData(form);
      var r = calculateTireSizeClient(
        parseFloat(fd.get('tireAWidth')), parseFloat(fd.get('tireAAspect')), parseFloat(fd.get('tireARim')),
        parseFloat(fd.get('tireBWidth')), parseFloat(fd.get('tireBAspect')), parseFloat(fd.get('tireBRim'))
      );
      var panel = document.querySelector('.result-panel');
      if (panel) {
        var speedoErr = r.comparison.speedometerErrorPct;
        var speedo60 = r.comparison.speedometerReadingAt60;
        var speedoLabel = 'Speedometer reads ' + Math.abs(speedoErr).toFixed(1) + '% ' + (speedoErr > 0 ? 'high' : 'low') + ': 60 shown = ' + speedo60.toFixed(1) + ' actual';
        var verdict = r.comparison.verdict;
        var verdictText = verdict === 'ok' ? 'Within common 3% tolerance' : verdict === 'caution' ? 'Caution: 3–5% difference' : 'Not recommended: >5% difference';
        var verdictClass = verdict === 'ok' ? 'verdict-ok' : verdict === 'caution' ? 'verdict-warn' : 'verdict-bad';
        panel.innerHTML = '<div class="verdict-badge ' + verdictClass + '">' + verdictText + '</div><div class="result-primary"><span class="result-value">' + fmtSigned(r.comparison.diameterDiffMm) + ' mm (' + fmtSigned(r.comparison.diameterDiffPct) + '%)</span><span class="result-label">Diameter Difference</span></div><dl class="result-secondary"><div class="result-row"><dt>Tire A Diameter</dt><dd>' + fmt(r.tireA.diameterIn, 2) + ' in (' + fmt(r.tireA.diameterMm) + ' mm)</dd></div><div class="result-row"><dt>Tire B Diameter</dt><dd>' + fmt(r.tireB.diameterIn, 2) + ' in (' + fmt(r.tireB.diameterMm) + ' mm)</dd></div><div class="result-row"><dt>Circumference Diff</dt><dd>' + fmtSigned(r.comparison.circumferenceDiffMm) + ' mm (' + fmtSigned(r.comparison.circumferenceDiffPct) + '%)</dd></div><div class="result-row"><dt>Ground Clearance</dt><dd>' + fmtSigned(r.comparison.groundClearanceChangeMm) + ' mm</dd></div><div class="result-row"><dt>Revs per Mile (A / B)</dt><dd>' + Math.round(r.tireA.revsPerMile).toLocaleString() + ' / ' + Math.round(r.tireB.revsPerMile).toLocaleString() + '</dd></div><div class="result-row"><dt>Revs per Km (A / B)</dt><dd>' + Math.round(r.tireA.revsPerKm).toLocaleString() + ' / ' + Math.round(r.tireB.revsPerKm).toLocaleString() + '</dd></div><div class="result-row"><dt>Speedometer at 60</dt><dd>' + fmt(r.comparison.speedometerReadingAt60) + ' MPH actual</dd></div><div class="result-row"><dt>Speedometer</dt><dd>' + speedoLabel + '</dd></div></dl><div class="speedo-table"><h4>Speedometer Table</h4><table><thead><tr><th>Indicated (MPH)</th><th>Actual (MPH)</th></tr></thead><tbody><tr><td>30</td><td>' + fmt(r.comparison.speedometerReadingAt30) + '</td></tr><tr><td>45</td><td>' + fmt(r.comparison.speedometerReadingAt45) + '</td></tr><tr><td>60</td><td>' + fmt(r.comparison.speedometerReadingAt60) + '</td></tr><tr><td>70</td><td>' + fmt(r.comparison.speedometerReadingAt70) + '</td></tr><tr><td>80</td><td>' + fmt(r.comparison.speedometerReadingAt80) + '</td></tr></tbody></table></div>';
      }
    });
  }
</script>

<style>
  fieldset { border: 1px solid var(--border-primary); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1rem; }
  legend { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); padding: 0 0.5rem; }
  .form-actions { display: flex; gap: 0.5rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-primary); }
  .btn-primary, .btn-secondary { padding: 0.625rem 1.25rem; font-size: 0.85rem; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; transition: all var(--transition); border: 1px solid transparent; }
  .btn-primary { background: var(--accent); color: var(--bg-primary); border-color: var(--accent); }
  .btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .btn-secondary { background: transparent; color: var(--text-secondary); border-color: var(--border-secondary); text-decoration: none; display: inline-flex; align-items: center; }
  .btn-secondary:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .worked-example { background: var(--bg-tertiary); padding: 1rem; border-radius: var(--radius-md); line-height: 1.8; }
  .worked-example ul { margin: 0; padding-left: 1.25rem; }
  .worked-example li { margin-bottom: 0.25rem; font-size: 0.9rem; }
  .worked-example strong { color: var(--accent); }
  .limitations { background: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: var(--radius-md); padding: 1rem; }
  .limitations p { margin-top: 0; margin-bottom: 0.5rem; }
  .limitations ul { margin: 0; padding-left: 1.25rem; }
  .limitations li { margin-bottom: 0.25rem; font-size: 0.9rem; }
  .verdict-badge { display: inline-block; padding: 0.375rem 0.75rem; border-radius: var(--radius-sm); font-size: 0.8rem; font-weight: 600; margin-bottom: 1rem; }
  .verdict-ok { background: rgba(62, 207, 142, 0.15); color: var(--success); border: 1px solid rgba(62, 207, 142, 0.3); }
  .verdict-warn { background: rgba(245, 179, 1, 0.15); color: var(--warning); border: 1px solid rgba(245, 179, 1, 0.3); }
  .verdict-bad { background: rgba(255, 107, 107, 0.15); color: var(--bad); border: 1px solid rgba(255, 107, 107, 0.3); }
  .speedo-table { margin-top: 1rem; }
  .speedo-table h4 { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 0.5rem; }
  .speedo-table table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .speedo-table th, .speedo-table td { padding: 0.375rem 0.5rem; border: 1px solid var(--border-primary); text-align: left; }
  .speedo-table th { background: var(--bg-tertiary); font-weight: 600; color: var(--text-secondary); }
</style>